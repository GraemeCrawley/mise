# Copy to .env and fill in. docker-compose.yml reads these.

# Optional. Without it, recipes still import from sites that publish
# structured recipe data (most recipe blogs), and you can always type
# ingredients in yourself. The key turns on the Claude fallback for
# messy pages and the ingredient double-check.
ANTHROPIC_API_KEY=

# Your timezone (IANA name, e.g. Europe/London), used for "today" and the plan.
TZ=UTC

# Where the web app listens on the host.
# 127.0.0.1 = this computer only. 0.0.0.0 = other devices on your network too.
MISE_BIND=127.0.0.1
MISE_PORT=8000

# Only if you serve Mise under a sub-path behind a reverse proxy that strips
# it (https://example.com/mise/ -> MISE_URL_PREFIX=/mise). Leave blank otherwise.
MISE_URL_PREFIX=
